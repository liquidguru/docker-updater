{
  // Type-checking config for editors / language servers (pyright, pylance).
  // Not part of the build — the container runs plain `python app.py`.
  //
  // Targets the same interpreter as the image (python:3.11-slim), and resolves
  // imports against ./.venv. That venv is REQUIRED — without the project's deps
  // installed, every `flask.*` / `docker.*` access reports as an error and the
  // output is worthless (~70 bogus errors). It's gitignored, so recreate with:
  //   python -m venv .venv && .venv/Scripts/pip install -r requirements.txt

  "venvPath": ".",
  "venv": ".venv",
  "pythonVersion": "3.11",
  "typeCheckingMode": "basic",

  "include": ["app.py"],
  "exclude": ["**/__pycache__", "data", "tests"],

  // ── Downgraded to warning: driven by docker-py's incomplete type stubs, ─────
  // not by real defects. Kept visible rather than silenced so a genuine one
  // still shows up — just not as an error.

  // `docker.errors` / `docker.types` aren't re-exported from `docker/__init__`,
  // so every `docker.errors.NotFound` reads as an unknown attribute.
  "reportAttributeAccessIssue": "warning",

  // The stubs type `Container.name`, `.id`, `.attrs` etc. as Optional, though
  // docker-py raises rather than returning None. See _is_helper_container.
  "reportOptionalMemberAccess": "warning",
  "reportOptionalSubscript": "warning",

  // `APIClient.update_container` really does accept a container-id str; the
  // stub insists on a _Container object.
  "reportArgumentType": "warning",

  // ── Kept as errors: these would be real bugs in our own code. ──────────────
  "reportUndefinedVariable": "error",
  "reportPossiblyUnboundVariable": "error",
  "reportSelfClsParameterName": "error",
  "reportRedeclaration": "error",
  "reportIndexIssue": "error",
  "reportCallIssue": "error"
}
